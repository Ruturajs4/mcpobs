# Ports and endpoints only. No secrets: Day 1 has no auth (Phase 1 adds keys).
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_MODE=otlp

# Two listeners, and using the wrong one fails confusingly: a host client
# connects to :9092 but then receives metadata advertising `kafka:9092`, which
# it cannot resolve. Containers use KAFKA_BOOTSTRAP; anything you run on the
# host (tests, scripts, kafka CLI from outside) uses KAFKA_HOST_BOOTSTRAP.
KAFKA_BOOTSTRAP=kafka:9092
KAFKA_HOST_BOOTSTRAP=localhost:29092
KAFKA_TOPIC=otlp.spans.raw
KAFKA_DLQ_TOPIC=otlp.spans.dlq
KAFKA_GROUP_ID=normalizer

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=mcpobs

DEMO_HTTP_PORT=8000
DOWNSTREAM_PORT=8899
