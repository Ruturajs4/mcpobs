{
  "name": "@mcpobs/node",
  "version": "0.1.2",
  "description": "MCP-native observability for TypeScript/Node MCP servers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruturajs4/mcpobs.git",
    "directory": "mcpobs-js"
  },
  "homepage": "https://github.com/Ruturajs4/mcpobs#readme",
  "bugs": {
    "url": "https://github.com/Ruturajs4/mcpobs/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opentelemetry",
    "observability",
    "tracing"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/auto-instrumentations-node": {
      "optional": true
    }
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^22.16.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.16",
    "zod": "^3.24.0"
  }
}
